{
  "name": "test-server",
  "version": "1.0.0",
  "description": "A test server",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run tsc",
    "docs": "ts-node ./src/docs/generator.ts",
    "lint": "eslint ./src ./test --max-warnings 0",
    "lint:fix": "eslint ./src ./test --max-warnings 0 --fix",
    "prettier": "prettier -w ./src ./test",
    "start": "npm run docs && npm run build && npm run start:pro",
    "start:pro": "node dist/index.js",
    "start:ts": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "tsc": "rm -rf ./dist && tsc -p tsconfig.compile.json",
    "watch": "nodemon",
    "mocha": "mocha"
  },
  "author": "Eric García de Ceca Elejoste",
  "license": "ISC",
  "_moduleAliases": {
    "@": "dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "cron": "^2.4.4",
    "dotenv": "^18.0.8",
    "express": "^4.17.1",
    "express-rate-limit": "^8.7.1",
    "joi": "^18.3.0",
    "jsonwebtoken": "^8.5.1",
    "module-alias": "^2.3.4",
    "mongoose": "^6.13.11",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-slack-webhook-transport": "^2.3.6",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.13",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.130",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "assert": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "swagger-jsdoc": "^6.3.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
